generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  icon      String
  highlight Boolean @default(false)
  order     Int
}

model ContentTab {
  id    String @id @default(cuid())
  label String
  slug  String @unique
  order Int
  books Book[]
}

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String
  coverUrl  String?
  language  String   @default("Indonesia")
  pages     Int
  readCount Int
  rating    Decimal  @db.Decimal(2, 1)
  priceUsd  Decimal  @db.Decimal(10, 2)
  isNew     Boolean  @default(false)
  order     Int      @default(0)
  tabSlug   String
  tab       ContentTab @relation(fields: [tabSlug], references: [slug], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tabSlug])
}

model Documentation {
  id        String   @id @default(cuid())
  title     String
  lead      String
  photoUrl  String
  eventDate DateTime
  checklist String[]
  published Boolean  @default(true)
}
