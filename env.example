# --- Database ---
# Docker lokal (container: postgres-local, postgres:16) → host port 5433
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/riekeu_dyah_pitaloka_dev?sslmode=disable"

# Untuk DB remote (Prisma Postgres) gunakan sslmode=verify-full, jangan turunkan ke require.

# --- Auth.js v5 ---
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# --- Google SSO ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Bootstrap admin (dipakai prisma/seed.ts) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Midtrans ---
# Kosongkan kalau sudah diisi lewat admin (/admin/profile → grup "Midtrans").
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MODE="sandbox"
MIDTRANS_ENABLED="false"

# --- SMTP (kontak + newsletter + OTP reset password) ---
# Bisa juga diisi lewat admin (/admin/profile → grup "Kontak / SMTP").
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_ENABLED="false"
SMTP_FROM=""
SMTP_TO=""
# Wajib kalau SMTP_HOST diisi alamat IP: nama domain untuk SNI + verifikasi
# sertifikat TLS (mis. mail.arsipitaloka.id).
SMTP_SERVERNAME=""

# --- Situs (dipakai untuk tautan di dalam email) ---
SITE_URL="http://localhost:3000"
