generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum DeliveryMethod {
  DELIVERY
  DOWNLOAD
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String? // null = akun hanya lewat Google
  image          String?
  googleId       String? @unique
  role           Role      @default(CUSTOMER)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  orders         Order[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Order {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId          String
  status          OrderStatus    @default(PENDING)
  deliveryMethod  DeliveryMethod @default(DOWNLOAD)
  deliveryAddress String?
  subtotal        Decimal        @db.Decimal(12, 2) // IDR, sebelum pajak
  taxType         String? // "PERCENTAGE" | "FIXED" (snapshot)
  taxAmount       Decimal        @db.Decimal(12, 2) @default(0)
  total           Decimal        @db.Decimal(12, 2) // IDR, yang ditagih
  usdToIdrRate    Decimal        @db.Decimal(10, 2) // kurs saat transaksi
  paymentProvider String? // "midtrans" | "manual"
  paymentMethod   String? // "QRIS" | "VA" | "EWALLET" | "FREE"
  paymentRef      String?        @unique
  paidAt          DateTime?
  items           OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id      String  @id @default(cuid())
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Restrict)
  bookId  String
  title   String // snapshot judul saat dibeli
  priceUsd Decimal @db.Decimal(10, 2) // snapshot harga (USD)
  qty     Int     @default(1)

  @@unique([orderId, bookId])
  @@index([bookId])
}

model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  icon      String
  highlight Boolean @default(false)
  order     Int
  books     Book[]
}

model ContentTab {
  id    String @id @default(cuid())
  label String
  slug  String @unique
  order Int
  books Book[]
  socialMedia SocialMedia[]
}

model Book {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  description     String?
  author          String
  translator      String?
  editor          String?
  illustrator     String?
  publisher       String?
  publishedYear   Int?
  edition         String?
  isbn            String?
  language        String     @default("Indonesia")
  pages           Int
  wordCount       Int?
  readCount       Int
  rating          Decimal    @db.Decimal(2, 1)
  priceUsd        Decimal    @db.Decimal(10, 2)
  isFree          Boolean    @default(false)
  isNew           Boolean    @default(false)
  archived        Boolean    @default(false)
  coverUrl        String?
  fileUrl         String?
  fileFormat      String?
  fileSize        Int?
  isDownloadable  Boolean    @default(false)
  copyrightHolder String?
  tiktokEmbed     String?
  order           Int        @default(0)
  tabId           String
  tab             ContentTab @relation(fields: [tabId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  socialMedia     SocialMedia[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([tabId])
  @@index([categoryId])
}

model Documentation {
  id        String   @id @default(cuid())
  title     String
  lead      String
  photoUrl  String
  eventDate DateTime
  checklist String[]
  published Boolean  @default(true)

  socialMedia SocialMedia[]
}

/// Postingan media sosial (TikTok, YouTube, Instagram) yang bisa diputar
/// di situs lewat iframe.
///
/// Postingan bisa berdiri sendiri, atau ditautkan ke buku, dokumentasi,
/// atau tab konten (mis. "Berita Terkini"). Semua relasi opsional.
model SocialMedia {
  id        String   @id @default(cuid())
  title     String
  caption   String?
  author    String?
  /// "tiktok" | "youtube" | "instagram"
  platform  String   @default("tiktok")
  /// Id video numerik (TikTok) atau id video platform (YouTube).
  videoId   String
  /// URL embed siap tempel. Kalau kosong, disusun dari platform + videoId.
  embedUrl  String?
  coverUrl  String?
  published Boolean  @default(true)
  order     Int      @default(0)

  bookId        String?
  book          Book?         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  documentationId String?
  documentation  Documentation? @relation(fields: [documentationId], references: [id], onDelete: Cascade)
  contentTabId  String?
  contentTab    ContentTab?   @relation(fields: [contentTabId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([documentationId])
  @@index([contentTabId])
  @@index([platform])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TiktokPost {
  id        String   @id @default(cuid())
  videoId   String   @unique
  embedUrl  String?
  title     String
  caption   String?
  author    String?
  highlight Boolean  @default(false)
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
